# Neo4j connection, only needed for the optional graph loaders:
#   python -m src.data.load_neo4j_graph
#   python -m src.data.load_neo4j_mixtures
# Copy this file to .env and fill in your own values. .env is gitignored; never commit it.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
